# ============================================================
#  Sentinel Backup System — Environment Variables
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ============================================================

# ── Encryption ──────────────────────────────────────────────
# The passphrase used to derive the AES-256-GCM encryption key
# via Argon2id.  Must be passed at backup time (never stored).
# For development the default is fine; use a strong passphrase
# in production.
SENTINEL_PASSPHRASE=demo-passphrase-change-me

# ── Jobs directory ───────────────────────────────────────────
# Directory that contains *.json job configuration files.
# The API server and CLI both read from this location.
# Default: ./jobs
SENTINEL_JOBS_DIR=jobs

# ── Ports exposed to the host ────────────────────────────────
# Change these if any port is already in use on your server.
# The containers always listen on their internal ports (8000,
# 5173, 9000, 9001); only the host-side mapping changes here.
#
# To check which ports are free on Linux before editing:
#   for p in 8000 5173 9000 9001; do
#     ss -tlnp | grep -q ":$p " && echo "OCUPADO: $p" || echo "LIBRE: $p"
#   done
API_PORT=8000
WEB_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Agent installer download ──────────────────────────────────────────
# Public URL of the Sentinel API server, used to pre-configure agent
# installers generated via GET /api/agents/{id}/download.
# If unset, the server derives the URL automatically from each request.
# Set this when the server is behind a reverse proxy or has a static IP.
# SENTINEL_PUBLIC_URL=http://192.168.1.87:8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the REST API.
# Add the server's LAN IP so the UI is accessible from other
# machines on the network (e.g. accessing mariaserver from a laptop).
SENTINEL_CORS_ORIGINS=http://localhost:5173,http://192.168.1.87:5173

# ── Web UI (outside Docker only) ─────────────────────────────
# URL the Vite dev-server proxy forwards /api/* and /ws/* to.
# Only needed when running `npm run dev` directly (not Docker).
# Default: http://localhost:8000
# VITE_API_TARGET=http://localhost:8000

# ── MinIO / S3 (optional) ────────────────────────────────────
# Credentials for the bundled MinIO container.
# Change these if you want a more secure setup.
MINIO_ROOT_USER=sentinel_admin
MINIO_ROOT_PASSWORD=sentinel_password

# For real AWS S3, set these instead and remove endpoint_url from job JSON:
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_DEFAULT_REGION=us-east-1
